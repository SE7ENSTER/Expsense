{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "slg-expense",
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "expensio-account-security",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "**/*.log",
        "**/*test*"
      ]
    }
  ]
}
